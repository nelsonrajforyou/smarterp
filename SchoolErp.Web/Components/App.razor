<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["SchoolErp.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="lib/flatpickr/flatpickr.min.css">
    <link rel="stylesheet" href="lib/flatpickr/airbnb.css">
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    
    <!-- Fastest possible theme flash prevention: runs before any CSS or body renders -->
    <script>
        (function(){
            var d=localStorage.getItem('user-dark-mode');
            document.documentElement.setAttribute('data-theme', d==='true'?'dark':'light');
            var c=localStorage.getItem('user-theme-color');
            if(c) {
                document.documentElement.style.setProperty('--primary-500',c);
                var result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(c);
                if(result) {
                    var r=parseInt(result[1], 16), g=parseInt(result[2], 16), b=parseInt(result[3], 16);
                    document.documentElement.style.setProperty('--primary-rgb', r + ',' + g + ',' + b);
                }
            }
            var f=localStorage.getItem('user-font-family');
            if(f) document.documentElement.style.setProperty('--font-family',f);
        })();
    </script>
    <script src="js/theme.js"></script>
</head>
<body>
    <Routes />
    <ReconnectModal />
    <script src="lib/flatpickr/flatpickr.min.js"></script>
    <script src="js/datepicker.js"></script>
    <script src="js/download.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
