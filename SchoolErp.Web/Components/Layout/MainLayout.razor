@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using SchoolErp.Application.Common.Interfaces

<div class="app-layout" id="app-layout-container">
    <aside class="app-sidebar" id="app-sidebar">
        <NavMenu />
    </aside>
    
    <div class="mobile-overlay d-md-none" onclick="toggleSidebar()"></div>

    <div class="app-main">
        <header class="app-header">
            <div class="header-left">
                <button class="header-icon-btn" onclick="toggleSidebar()" title="Toggle Sidebar">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <line x1="3" y1="12" x2="21" y2="12"/>
                        <line x1="3" y1="18" x2="21" y2="18"/>
                    </svg>
                </button>

                <div class="search-box">
                    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input type="text" id="global-search-input" name="globalSearchInput" placeholder="Search..." class="search-input" />
                </div>

                <div class="header-academic-year ms-3">
                    <div class="year-selector-wrapper">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="calendar-icon">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
                        </svg>
                        <select id="academic-year-select" name="academicYearSelect" class="year-select" @bind="CurrentYearId" @bind:after="OnYearChangedInternal">
                            @foreach (var year in AcademicYears)
                            {
                                <option value="@year.Value">@year.Text</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="header-right">
                <!-- Theme Toggle -->
                <button class="theme-toggle-btn me-2" onclick="toggleTheme()" title="Toggle Theme">
                    <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.07" x2="5.64" y2="17.66"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                    </svg>
                </button>

                <!-- Notifications -->
                <div class="notification-dropdown-container position-relative me-2">
                    <button class="header-icon-btn" onclick="toggleNotifications()" title="Notifications">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 01-3.46 0"/>
                        </svg>
                        <span class="notification-badge"></span>
                    </button>
                    <div id="notification-dropdown" class="notification-dropdown" style="display: none;">
                        <div class="dropdown-header">
                            <h6>Notifications</h6>
                            <span class="badge bg-primary rounded-pill text-white" style="font-size: 0.75rem;">3 New</span>
                        </div>
                        <div class="dropdown-body">
                            <div class="notification-item">
                                <div class="notification-icon bg-primary-50 text-primary"><i class="bi bi-person-plus"></i></div>
                                <div class="notification-content">
                                    <p class="notification-text">New student registration pending.</p>
                                    <span class="notification-time">10m ago</span>
                                </div>
                            </div>
                            <div class="notification-item">
                                <div class="notification-icon bg-warning-50 text-warning"><i class="bi bi-cash-coin"></i></div>
                                <div class="notification-content">
                                    <p class="notification-text">Fee payment received.</p>
                                    <span class="notification-time">1h ago</span>
                                </div>
                            </div>
                        </div>
                        <div class="dropdown-footer">
                            <a href="#">View All</a>
                        </div>
                    </div>
                </div>

                <!-- Customization Settings -->
                <ThemeSwitcher />

                <div class="header-divider"></div>

                <AuthorizeView>
                    <Authorized>
                        <div class="header-user">
                            <div class="header-avatar">
                                @(context.User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "A")
                            </div>
                            <div class="header-user-info">
                                <span class="header-user-name">@context.User.Identity?.Name</span>
                                <span class="header-user-role">@(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Guest")</span>
                            </div>
                            <a href="/logout" class="btn-logout" title="Sign out">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                                    <polyline points="16 17 21 12 16 7"/>
                                    <line x1="21" y1="12" x2="9" y2="12"/>
                                </svg>
                            </a>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <section class="app-content">
            @Body
        </section>
    </div>
</div>


<script>
    function toggleSidebar() {
        const layout = document.getElementById('app-layout-container');
        const sidebar = document.getElementById('app-sidebar');
        layout.classList.toggle('sidebar-toggled');
        sidebar.classList.toggle('toggled');
    }

    function toggleTheme() {
        if (window.themeManager) {
            window.themeManager.toggleDarkMode();
        }
    }

    function toggleNotifications() {
        const dropdown = document.getElementById('notification-dropdown');
        dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
        
        // Close when clicking outside
        if (dropdown.style.display === 'block') {
            const closeHandler = (e) => {
                if (!e.target.closest('.notification-dropdown-container')) {
                    dropdown.style.display = 'none';
                    document.removeEventListener('click', closeHandler);
                }
            };
            setTimeout(() => document.addEventListener('click', closeHandler), 10);
        }
    }
</script>

@inject IAcademicYearService AcademicYearService
@inject NavigationManager Navigation

<style>
    .header-academic-year {
        background: rgba(99, 102, 241, 0.08);
        border-radius: 10px;
        padding: 4px 10px;
        border: 1px solid rgba(99, 102, 241, 0.2);
        transition: all 0.2s;
    }
    .header-academic-year:hover {
        background: rgba(99, 102, 241, 0.12);
        border-color: rgba(99, 102, 241, 0.3);
    }
    .year-selector-wrapper {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .calendar-icon {
        color: #6366f1;
        opacity: 0.8;
    }
    .year-select {
        background: transparent;
        border: none;
        color: #475569;
        font-size: 0.85rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        padding: 0;
        margin: 0;
    }
    [data-theme='dark'] .year-select { color: #cbd5e1; }
    [data-theme='dark'] .header-academic-year { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); }
</style>

@code {
    private string? CurrentYearId { get; set; }
    private List<SchoolErp.Application.Common.Models.DropdownItem> AcademicYears { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        AcademicYears = await AcademicYearService.GetAllYearsAsync();
        CurrentYearId = await AcademicYearService.GetCurrentYearIdAsync();
    }

    private async Task OnYearChangedInternal()
    {
        var selectedYear = AcademicYears.FirstOrDefault(y => y.Value == CurrentYearId);
        if (selectedYear != null)
        {
            await AcademicYearService.SetCurrentYearAsync(selectedYear.Value, selectedYear.Text);
            // Optional: Reload the current page to refresh data based on new year
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
    }
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
