@page "/student-management"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using SchoolErp.Application.Common.Interfaces
@using SchoolErp.Application.Common.Models
@inject IJSRuntime JSRuntime
@inject ICommonDataService CommonData
@inject IAcademicService AcademicService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAcademicYearService AcademicYearService

<div class="management-container p-4 animate-fade-in-up" style="min-height: 100vh;">
    @if (!ShowForm)
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.75rem;">Students Management</h2>
                <p class="text-muted mb-0">View and manage all student records in the system</p>
            </div>
            <div class="d-flex gap-3">
                <button class="btn btn-white border px-3 py-2 fw-medium shadow-sm d-flex align-items-center bg-white"><i class="bi bi-gear me-2 text-muted"></i>Table Settings</button>
                <button class="btn btn-white border px-3 py-2 fw-medium shadow-sm d-flex align-items-center bg-white"><i class="bi bi-file-earmark-text me-2 text-muted"></i>Reports</button>
                <button class="btn btn-primary px-4 py-2 fw-medium shadow-sm d-flex align-items-center" style="background: #4f46e5; border-color: #4f46e5;" @onclick="OpenAddForm">
                    <i class="bi bi-plus fs-5 me-1"></i>Add New Student
                </button>
            </div>
        </div>

        <!-- Compact Stats Badges -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #eef2ff; color: #4f46e5;">
                    <i class="bi bi-people fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted fw-semibold" style="font-size: 0.8rem;">Total Students:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">1,248</span>
                    <span class="text-success ms-1" style="font-size: 0.75rem; font-weight: 500;"><i class="bi bi-arrow-up-short"></i>8.5%</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-person-badge fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted fw-semibold" style="font-size: 0.8rem;">Male:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">648</span>
                    <span class="text-primary ms-1" style="font-size: 0.75rem; font-weight: 500;">51.9%</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #fce7f3; color: #db2777;">
                    <i class="bi bi-person-dress fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted fw-semibold" style="font-size: 0.8rem;">Female:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">600</span>
                    <span class="text-danger ms-1" style="font-size: 0.75rem; font-weight: 500;">48.1%</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #dcfce7; color: #16a34a;">
                    <i class="bi bi-mortarboard fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted fw-semibold" style="font-size: 0.8rem;">New Admissions:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">128</span>
                    <span class="text-success ms-1" style="font-size: 0.75rem; font-weight: 500;"><i class="bi bi-arrow-up-short"></i>12.3%</span>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- Main Content: Table -->
            <div class="col-lg-9">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <!-- Toolbar inside card -->
                    <div class="card-header bg-white border-bottom-0 py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4">
                        <div class="d-flex gap-3 flex-grow-1" style="max-width: 600px;">
                            <div class="position-relative flex-grow-1">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                <input type="text" class="form-control bg-light border-0 py-2 ps-5 rounded-3" placeholder="Search by name, admission no, mobile no..." @bind="SearchTerm" @bind:event="oninput">
                            </div>
                            <select class="form-select bg-light border-0 py-2 rounded-3" style="width: 160px;" @bind="SelectedClass">
                                <option value="">All Classes</option>
                                @foreach (var cls in Classes) { <option value="@cls.Value">@cls.Text</option> }
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-white border fw-medium bg-white rounded-3 shadow-sm d-flex align-items-center"><i class="bi bi-funnel me-2"></i>Filter</button>
                            <button class="btn btn-white border fw-medium bg-white rounded-3 shadow-sm d-flex align-items-center"><i class="bi bi-three-dots"></i> More</button>
                            <div class="btn-group shadow-sm rounded-3">
                                <button class="btn btn-white border bg-white active text-primary"><i class="bi bi-grid"></i></button>
                                <button class="btn btn-white border bg-white"><i class="bi bi-list"></i></button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 custom-datatable" id="studentsTable" style="width:100%">
                                <thead style="background: #f8fafc;">
                                    <tr>
                                        <th class="ps-4" style="width: 40px; color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;"><input class="form-check-input" type="checkbox"></th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">STUDENT</th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">MOBILE NO &darr;</th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">ADMISSION NO &darr;</th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">CLASS &darr;</th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">GENDER &darr;</th>
                                        <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">STATUS &darr;</th>
                                        <th class="text-end pe-4" style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody class="border-top-0">
                                    @foreach (var student in FilteredStudents)
                                    {
                                        <tr>
                                            <td class="ps-4"><input class="form-check-input" type="checkbox"></td>
                                            <td>
                                                <div class="d-flex align-items-center py-2">
                                                    <div class="me-3 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: 8px; background: #eef2ff; color: #4f46e5; font-weight: 600; font-size: 0.9rem;">
                                                        @student.NAME[0]
                                                    </div>
                                                    <div>
                                                        <div class="fw-bold text-dark" style="font-size: 0.9rem;">@student.NAME</div>
                                                        <div class="text-muted" style="font-size: 0.8rem;">@(student.NAME.ToLower().Replace(" ", "."))@("@email.com")</div>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center text-dark fw-medium" style="font-size: 0.9rem;">
                                                    <i class="bi bi-telephone text-muted me-2" style="font-size: 0.85rem;"></i>
                                                    23423324
                                                </div>
                                            </td>
                                            <td><span class="text-primary fw-medium" style="font-size: 0.9rem;">@student.ADMISSION_NO</span></td>
                                            <td><span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #eef2ff; color: #4f46e5; font-size: 0.8rem;">@student.CLASS_NAME</span></td>
                                            <td>
                                                <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #e0f2fe; color: #0284c7; font-size: 0.8rem;">Male</span>
                                            </td>
                                            <td>
                                                @if(student.IS_ACTIVE == "1") {
                                                    <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #dcfce7; color: #16a34a; font-size: 0.8rem;">Active</span>
                                                } else {
                                                    <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #fef3c7; color: #d97706; font-size: 0.8rem;">Inactive</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-white border rounded-2 me-1 shadow-sm"><i class="bi bi-pencil-square text-muted"></i></button>
                                                <button class="btn btn-sm btn-white border rounded-2 shadow-sm text-danger"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Sidebar Filters -->
            <div class="col-lg-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center rounded-top-4">
                        <h5 class="mb-0 fw-bold d-flex align-items-center" style="font-size: 1.1rem;"><i class="bi bi-funnel text-muted me-2"></i>Filters</h5>
                        <a href="#" class="text-primary text-decoration-none fw-medium" style="font-size: 0.85rem;">Clear All</a>
                    </div>
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Class</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium">
                                <option>All Classes</option>
                            </select>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Gender</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium">
                                <option>All Genders</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Status</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium">
                                <option>All Status</option>
                            </select>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Admission Date</label>
                            <div class="position-relative">
                                <input type="text" class="form-control bg-light border-0 py-2 pe-5 rounded-3 text-dark fw-medium" placeholder="01/01/2026 - 31/12/2026">
                                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                            </div>
                        </div>
                        
                        <div class="d-grid gap-3 mt-auto pt-4 border-top">
                            <button class="btn btn-primary py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;">Apply Filters</button>
                            <button class="btn btn-white border py-2 fw-medium rounded-3 d-flex align-items-center justify-content-center bg-white"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset Filters</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <SchoolErp.Web.Components.Modules.Students.Shared.StudentAdmissionForm 
            Model="StudentForm" 
            Genders="Genders" 
            Religions="Religions" 
            Classes="Classes" 
            OnSubmit="SaveStudent" 
            OnCancel="CloseForm" />
    }
</div>

