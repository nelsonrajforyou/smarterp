@page "/student-management"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using SchoolErp.Application.Common.Interfaces
@using SchoolErp.Application.Common.Models
@inject ICommonDataService CommonData
@inject IAcademicService AcademicService
@inject AuthenticationStateProvider AuthStateProvider
@inject IAcademicYearService AcademicYearService

<div class="management-container animate-fade-in-up">
    <header class="page-header">
        <div class="header-main">
            <h1>Student Management</h1>
            <p>Enroll and manage student profiles for the current academic year</p>
        </div>
        @if (!ShowForm)
        {
            <button class="btn-primary-modern" @onclick="OpenAddForm">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Admission Entry
            </button>
        }
    </header>

    @if (!ShowForm)
    {
        <!-- Search & Filter Bar -->
        <div class="card-modern animate-fade-in" style="margin-bottom: 1.5rem; padding: 1.25rem;">
            <div class="row g-4" style="align-items: flex-end;">
                <div class="col-md-5">
                    <label class="form-label">Search Student</label>
                    <div style="position: relative;">
                        <svg style="position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted);" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input type="text" class="form-control-modern" style="padding-left: 2.8rem;" placeholder="Search by name, admission no..." @bind="SearchTerm" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Class</label>
                    <select @bind="SelectedClass" class="form-select-modern">
                        <option value="">All Classes</option>
                        @foreach (var cls in Classes)
                        {
                            <option value="@cls.Value">@cls.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <div style="display: flex; gap: 0.5rem;">
                        <button class="btn-secondary-modern" style="flex: 1;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            Export
                        </button>
                        <button class="btn-secondary-modern" style="flex: 1;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                            Import
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="table-card animate-fade-in">
            <div class="card-header-modern" style="padding: 1rem 1.5rem; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: var(--gray-50);">
                <h3 style="font-size: 0.9rem; font-weight: 700; color: var(--text-primary); margin: 0;">Student Directory</h3>
                <span class="badge-modern badge-info">@FilteredStudents.Count() Records Found</span>
            </div>
            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Adm No</th>
                            <th>Class</th>
                            <th>Parent Details</th>
                            <th>Status</th>
                            <th style="text-align: right;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in FilteredStudents)
                        {
                            <tr>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 1rem;">
                                        <div class="avatar-modern">@student.NAME[0]</div>
                                        <div style="font-weight: 700;">@student.NAME</div>
                                    </div>
                                </td>
                                <td><code style="font-size: 0.8rem; background: var(--gray-100); padding: 2px 6px; border-radius: 4px;">@student.ADMISSION_NO</code></td>
                                <td><span class="badge-modern badge-info">@student.CLASS_NAME</span></td>
                                <td>
                                    <div style="font-size: 0.8rem; color: var(--text-secondary);">F: @student.FATHER_NAME</div>
                                    <div style="font-size: 0.75rem; color: var(--text-muted);">M: @student.MOTHER_NAME</div>
                                </td>
                                <td>
                                    <span class="badge-modern @(student.IS_ACTIVE == "1" ? "badge-success" : "badge-danger")">
                                        <span class="status-dot @(student.IS_ACTIVE == "1" ? "bg-success" : "bg-danger")"></span>
                                        @(student.IS_ACTIVE == "1" ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    <div class="action-buttons" style="justify-content: flex-end;">
                                        <button class="btn-icon-modern" title="View Profile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                        <button class="btn-icon-modern" title="Edit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Admission Form View -->
        <SchoolErp.Web.Components.Modules.Students.Shared.StudentAdmissionForm 
            Model="StudentForm" 
            Genders="Genders" 
            Religions="Religions" 
            Classes="Classes" 
            OnSubmit="SaveStudent" 
            OnCancel="CloseForm" />
    }
</div>

<style>
    .section-subtitle {
        font-size: 0.85rem;
        color: var(--primary-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin: 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--primary-50);
    }
</style>

@code {
    private bool ShowForm = false;
    private string SearchTerm = "";
    private string SelectedClass = "";
    private List<DropdownItem> Genders = new();
    private List<DropdownItem> Religions = new();
    private List<DropdownItem> Classes = new();
    private List<StudentDirectoryModel> StudentsList = new();
    private SchoolErp.Web.Components.Modules.Students.Shared.StudentAdmissionForm.StudentFormModel StudentForm = new();

    protected override async Task OnInitializedAsync()
    {
        Genders = await CommonData.GetGenderListAsync();
        Religions = await AcademicService.GetDynamicListAsync("SUP_RELIGION", "RELIGION_ID", "RELIGION_NAME");
        Classes = await CommonData.GetClassListAsync();
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        StudentsList = await AcademicService.GetStudentDirectoryAsync(SelectedClass);
    }

    private IEnumerable<StudentDirectoryModel> FilteredStudents => StudentsList
        .Where(s => (string.IsNullOrEmpty(SearchTerm) || s.NAME.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || s.ADMISSION_NO.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)));

    private void OpenAddForm() 
    {
        StudentForm = new();
        ShowForm = true;
    }
    private void CloseForm() => ShowForm = false;

    private async Task SaveStudent()
    {
        // Admission saving logic here using StudentForm
        await LoadStudents();
        CloseForm();
        StudentForm = new();
    }
}
