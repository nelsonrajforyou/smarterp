    // New column form fields
    private bool IsAddingColumn = false;
    private string NewColumnName = string.Empty;
    private string NewColumnDataType = "VARCHAR(255)";
    private bool IsNewColumnRef = false;
    private string RefTableName = string.Empty;
    private string RefPrimaryKey = string.Empty;
    private string RefDisplayColumn = string.Empty;
    private string? ColumnAddError;

    private async Task AddNewColumn()
    {
        try
        {
            ColumnAddError = null;
            if (string.IsNullOrWhiteSpace(NewColumnName))
            {
                ColumnAddError = "Column name cannot be empty.";
                return;
            }

            var cmd = new AddTableColumnCommand
            {
                TableName = "STUDENTS_INFO",
                ColumnName = NewColumnName.ToUpper(),
                DataType = NewColumnDataType,
                IsReference = IsNewColumnRef,
                RefTableName = RefTableName?.ToUpper(),
                RefPrimaryKey = RefPrimaryKey?.ToUpper(),
                RefDisplayColumn = RefDisplayColumn?.ToUpper()
            };

            await Mediator.Send(cmd);
            
            // Reload available columns
            AvailableColumns = await Mediator.Send(new GetTableColumnsQuery { TableName = "STUDENTS_INFO" });
            SelectedColumns.Add(NewColumnName.ToUpper());
            
            // Reset state
            IsAddingColumn = false;
            NewColumnName = "";
            IsNewColumnRef = false;
            RefTableName = "";
            RefPrimaryKey = "";
            RefDisplayColumn = "";
            
            await LoadStudents();
        }
        catch (Exception ex)
        {
            ColumnAddError = ex.Message;
        }
    }
}
