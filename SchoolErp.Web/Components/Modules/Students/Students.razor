@code {
    private bool IsLoading = true;
    private bool ShowForm = false;
    private bool IsEditMode = false;
    private bool ShowSettingsModal = false;
    private bool ShowReportModal = false;
    private string? ErrorMessage;
    private string ViewMode = "list";
    
    private string? SearchTerm;
    private int PageNumber = 1;
    private const int PageSize = 10;
    
    private PaginatedList<IDictionary<string, object>>? StudentsList;
    private List<DropdownItem>? Classes;
    private StudentFormModel StudentForm = new();

    private bool ShowSidebar = true;
    private StudentStatsDto? Stats;
    private string? FilterClassId;
    private string? FilterGenderId;
    private List<ColumnDto> AvailableColumns = new();
    private List<string> SelectedColumns = new();
    private List<string> SelectedReportColumns = new();
    private string ReportType = "General";
    private string ReportExportType = "Excel";
    private bool IsGeneratingReport = false;
    // Cache for sub-table lookups (e.g. Community, Gender) if needed.
    private Dictionary<string, string> SubTableMap = new();

    protected override async Task OnInitializedAsync()
    {
        Classes = await CommonData.GetClassListAsync();
        Stats = await Mediator.Send(new GetStudentStatsQuery());
        
        // Load available columns from DB schema
        AvailableColumns = await Mediator.Send(new GetTableColumnsQuery { TableName = "STUDENTS_INFO" });
        
        // Set default selected columns
        var defaults = new[] { "STUDENT_ID", "NAME", "ADMISSION_NO", "MOBILE_NO", "GENDER_ID", "CLASS_ID" };
        SelectedColumns = AvailableColumns
            .Where(c => defaults.Contains(c.ColumnName))
            .Select(c => c.ColumnName)
            .ToList();
            
        // Make sure we always include NAME and STUDENT_ID
        if (!SelectedColumns.Contains("NAME")) SelectedColumns.Insert(0, "NAME");
        if (!SelectedColumns.Contains("STUDENT_ID")) SelectedColumns.Insert(0, "STUDENT_ID");

        await LoadStudents();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsLoading && !ShowForm && ViewMode == "list" && StudentsList != null && StudentsList.Items.Any())
        {
            try
            {
                await JS.InvokeVoidAsync("eval", "if ($.fn.DataTable.isDataTable('#studentsTable')) { $('#studentsTable').DataTable().destroy(); } $('#studentsTable').DataTable({ paging: false, ordering: true, info: false, searching: false, lengthChange: false });");
            }
            catch (Exception)
            {
                // Suppress JS disconnected errors during navigation
            }
        }
    }

    private void ToggleSettings()
    {
        ShowSettingsModal = !ShowSettingsModal;
        if (ShowSettingsModal) ShowReportModal = false;
    }

    private void ToggleReport()
    {
        ShowReportModal = !ShowReportModal;
        if (ShowReportModal)
        {
            ShowSettingsModal = false;
            SelectedReportColumns = new List<string>(SelectedColumns);
        }
    }

    private void OnReportColumnToggle(string columnName, object? isChecked)
    {
        bool isSelected = (bool)(isChecked ?? false);
        if (isSelected && !SelectedReportColumns.Contains(columnName))
            SelectedReportColumns.Add(columnName);
        else if (!isSelected && SelectedReportColumns.Contains(columnName))
            SelectedReportColumns.Remove(columnName);
    }

    private async Task GenerateReport()
    {
        if (!SelectedReportColumns.Any()) return;
        
        IsGeneratingReport = true;
        try
        {
            var response = await Mediator.Send(new GenerateStudentReportQuery
            {
                SearchTerm = SearchTerm,
                SelectedColumns = SelectedReportColumns,
                ExportType = ReportExportType
            });

            using var stream = new MemoryStream(response.Content);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", response.FileName, streamRef);
            
            ShowReportModal = false;
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error generating report: " + ex.Message;
        }
        finally
        {
            IsGeneratingReport = false;
        }
    }

    private void OnColumnSelectionChanged(string columnName, object? isChecked)
    {
        if (columnName == "STUDENT_ID" || columnName == "NAME") return; // Prevent toggling required columns
        
        bool isSelected = (bool)(isChecked ?? false);
        if (isSelected && !SelectedColumns.Contains(columnName))
        {
            SelectedColumns.Add(columnName);
        }
        else if (!isSelected && SelectedColumns.Contains(columnName))
        {
            SelectedColumns.Remove(columnName);
        }
    }

    private async Task ApplySettings()
    {
        ShowSettingsModal = false;
        await LoadPage(1); // Re-fetch with new columns
    }

    private object? GetColumnValue(IDictionary<string, object> dict, string key)
    {
        // Dictionary keys from DB might be case-sensitive, but typically Dapper dynamic uses exact or uppercase
        // We'll do a case-insensitive check to be safe
        var matchedKey = dict.Keys.FirstOrDefault(k => string.Equals(k, key, StringComparison.OrdinalIgnoreCase));
        if (matchedKey != null && dict.TryGetValue(matchedKey, out var value))
        {
            return value;
        }
        return null;
    }

    private string GetStringValue(IDictionary<string, object> dict, string key)
    {
        return GetColumnValue(dict, key)?.ToString() ?? string.Empty;
    }

    // This method handles sub table ids to display readable values
    private string GetDisplayValue(IDictionary<string, object> row, string columnName, object? rawValue)
    {
        // First check if the backend dynamically joined a display column for this
        var mappedDisplay = GetColumnValue(row, $"{columnName}_DISPLAY");
        if (mappedDisplay != null && !string.IsNullOrEmpty(mappedDisplay.ToString()))
        {
            return mappedDisplay.ToString()!;
        }

        if (rawValue == null) return "—";
        var strValue = rawValue.ToString();
        if (string.IsNullOrEmpty(strValue)) return "—";

        // Handle sub table mapping fallback
        if (columnName.EndsWith("_ID", StringComparison.OrdinalIgnoreCase))
        {
            // For GENDER_ID, it is already "Male" / "Female" based on our standard DB inserts
            if (columnName.Equals("CLASS_ID", StringComparison.OrdinalIgnoreCase) && Classes != null)
            {
                var classItem = Classes.FirstOrDefault(c => c.Value == strValue);
                if (classItem != null) return classItem.Text;
            }
        }
        
        return strValue!;
    }

    private async Task LoadStudents()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            StudentsList = await Mediator.Send(new GetDynamicStudentsQuery 
            { 
                SearchTerm = SearchTerm,
                ClassId = FilterClassId,
                GenderId = FilterGenderId,
                PageNumber = PageNumber, 
                PageSize = PageSize,
                SelectedColumns = SelectedColumns
            });
        }
        catch (Exception ex)
        {
            ErrorMessage = "Error loading students: " + ex.Message;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task ResetFilters()
    {
        SearchTerm = null;
        FilterClassId = null;
        FilterGenderId = null;
        await LoadPage(1);
    }

    private async Task LoadPage(int pageNumber)
    {
        PageNumber = pageNumber;
        await LoadStudents();
    }
    
    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoadPage(1);
        }
    }

    private void ShowCreateForm()
    {
        IsEditMode = false;
        StudentForm = new StudentFormModel { DateOfBirth = DateTime.Today.AddYears(-10) };
        ErrorMessage = null;
        ShowForm = true;
    }

    private async Task EditStudent(string id)
    {
        if(string.IsNullOrEmpty(id)) return;
        
        // Fetch full details for edit form using new query
        var student = await Mediator.Send(new GetStudentByIdQuery { Id = id });
        if (student == null) return;

        IsEditMode = true;
        StudentForm = new StudentFormModel
        {
            Id = student.STUDENT_ID,
            Name = student.NAME,
            MobileNo = student.MOBILE_NO,
            FatherName = student.FATHER_NAME,
            MotherName = student.MOTHER_NAME,
            Address = student.ADDRESS,
            AdmissionNo = student.ADMISSION_NO,
            EmailId = student.EMAIL_ID,
            GenderId = student.GENDER_ID,
            DateOfBirth = DateTime.TryParse(student.DATE_OF_BIRTH, out var d) ? d : DateTime.Today,
            StateId = student.STATE_ID,
            NationalityId = student.NATIONALITY_ID,
            UserId = student.USER_ID,
            ClassId = student.CLASS_ID,
            RegisterNo = student.REGISTER_NO,
            RollNo = student.ROLL_NO
        };
        ErrorMessage = null;
        ShowForm = true;
    }

    private void CancelForm()
    {
        ShowForm = false;
    }

    private async Task SaveStudent()
    {
        try
        {
            if (IsEditMode)
            {
                var command = new UpdateStudentCommand
                {
                    Id = StudentForm.Id!,
                    Name = StudentForm.Name,
                    MobileNo = StudentForm.MobileNo,
                    FatherName = StudentForm.FatherName,
                    MotherName = StudentForm.MotherName,
                    Address = StudentForm.Address,
                    AdmissionNo = StudentForm.AdmissionNo,
                    EmailId = StudentForm.EmailId,
                    GenderId = StudentForm.GenderId,
                    DateOfBirth = StudentForm.DateOfBirth.ToString("yyyy-MM-dd"),
                    StateId = StudentForm.StateId,
                    NationalityId = StudentForm.NationalityId,
                    ClassId = StudentForm.ClassId,
                    RegisterNo = StudentForm.RegisterNo,
                    RollNo = StudentForm.RollNo
                };
                await Mediator.Send(command);
            }
            else
            {
                var command = new CreateStudentCommand
                {
                    Name = StudentForm.Name,
                    MobileNo = StudentForm.MobileNo,
                    FatherName = StudentForm.FatherName,
                    MotherName = StudentForm.MotherName,
                    Address = StudentForm.Address,
                    AdmissionNo = StudentForm.AdmissionNo,
                    EmailId = StudentForm.EmailId,
                    GenderId = StudentForm.GenderId,
                    DateOfBirth = StudentForm.DateOfBirth.ToString("yyyy-MM-dd"),
                    StateId = StudentForm.StateId,
                    NationalityId = StudentForm.NationalityId,
                    UserId = StudentForm.UserId,
                    ClassId = StudentForm.ClassId,
                    AcademicYearId = (await AuthStateProvider.GetAuthenticationStateAsync())
                                        .User.FindFirst("academicyearid")?.Value ?? await AcademicYearService.GetCurrentYearIdAsync(),
                    RegisterNo = StudentForm.RegisterNo,
                    RollNo = StudentForm.RollNo
                };
                await Mediator.Send(command);
            }

            ShowForm = false;
            await LoadStudents();
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred while saving the student: " + ex.Message;
        }
    }

    private async Task DeleteStudent(string id)
    {
        if(string.IsNullOrEmpty(id)) return;
        await Mediator.Send(new DeleteStudentCommand { Id = id });
        await LoadStudents();
    }

