@page "/students"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using SchoolErp.Application.Common.Models
@using SchoolErp.Application.Features.Students
@using SchoolErp.Application.Features.Settings
@using SchoolErp.Application.Common.Mediator
@attribute [Authorize(Roles = "Admin,Teacher")]
@inject IMediator Mediator
@inject SchoolErp.Application.Common.Interfaces.ICommonDataService CommonData
@inject SchoolErp.Application.Common.Interfaces.IAcademicYearService AcademicYearService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Students Management - School ERP</PageTitle>

<div class="management-container p-3 animate-fade-in-up" style="min-height: 100vh;">
    @if (!ShowForm)
    {
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="header-main">
                <h2 class="fw-bold mb-1 text-dark" style="font-size: 1.35rem;">Students Management</h2>
                <p class="text-muted mb-0" style="font-size: 0.65rem;">View and manage all student records in the system</p>
            </div>
            <div class="d-flex gap-3">
                <button class="btn btn-white border px-3 py-2 fw-medium shadow-sm d-flex align-items-center bg-white" @onclick="ToggleSettings"><i class="bi bi-gear me-2 text-muted"></i>Table Settings</button>
                <button class="btn btn-white border px-3 py-2 fw-medium shadow-sm d-flex align-items-center bg-white" @onclick="ToggleReport"><i class="bi bi-file-earmark-text me-2 text-muted"></i>Reports</button>
                <button class="btn btn-primary px-4 py-2 fw-medium shadow-sm d-flex align-items-center" style="background: #4f46e5; border-color: #4f46e5;" @onclick="ShowCreateForm">
                    <i class="bi bi-plus fs-5 me-1"></i>Add New Student
                </button>
            </div>
        </div>

        <!-- Compact Stats Badges -->
        <div class="d-flex flex-wrap gap-2 mb-3">
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #eef2ff; color: #4f46e5;">
                    <i class="bi bi-people fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted text-dark fw-semibold" style="font-size: 0.8rem;">Total Students:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Stats?.TotalStudents ?? 0)</span>
                    <span class="text-success ms-1" style="font-size: 0.75rem; font-weight: 500;"><i class="bi bi-arrow-up-short"></i>8.5%</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle  d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #e0f2fe; color: #0284c7;">
                    <i class="bi bi-person-badge fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted text-dark fw-semibold" style="font-size: 0.8rem;">Male:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Stats?.MaleCount ?? 0)</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #fce7f3; color: #db2777;">
                    <i class="bi bi-person-dress fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted text-dark fw-semibold" style="font-size: 0.8rem;">Female:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Stats?.FemaleCount ?? 0)</span>
                </div>
            </div>
            <div class="d-flex align-items-center px-3 py-2 rounded-pill bg-white border shadow-sm">
                <div class="rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 28px; height: 28px; background: #dcfce7; color: #16a34a;">
                    <i class="bi bi-mortarboard fs-6"></i>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <span class="text-muted text-dark fw-semibold" style="font-size: 0.8rem;">New Admissions:</span>
                    <span class="fw-bold text-dark" style="font-size: 0.9rem;">@(Stats?.NewAdmissionsCount ?? 0)</span>
                    <span class="text-success ms-1" style="font-size: 0.75rem; font-weight: 500;"><i class="bi bi-arrow-up-short"></i>30d</span>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Main Content: Table -->
            <div class="col-lg-@(ShowSidebar ? "9" : "12")">
                <div class="card border-0 shadow-sm rounded-4 h-100 d-flex flex-column">
                    <div class="card-header bg-white border-bottom-0 py-2 px-3 d-flex justify-content-between align-items-center rounded-top-3">
                        <div class="d-flex gap-3 flex-grow-1" style="max-width: 600px;">
                            <div class="position-relative flex-grow-1">
                                <i class="bi bi-search position-absolute top-50 start-0 translate-middle-y ms-3 text-muted"></i>
                                <input type="text" class="form-control bg-light border-0 py-2 ps-5 rounded-3" placeholder="Search by name, admission no, mobile no..." @bind="SearchTerm" @bind:event="oninput" @onkeyup="HandleSearch">
                            </div>
                            <select class="form-select bg-light border-0 py-2 rounded-3" style="width: 160px;" value="@FilterClassId" @onchange="@(async e => { FilterClassId = e.Value?.ToString(); await LoadPage(1); })">
                                <option value="">All Classes</option>
                                @if (Classes != null)
                                {
                                    @foreach (var cls in Classes) { <option value="@cls.Value">@cls.Text</option> }
                                }
                            </select>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-white border fw-medium bg-white rounded-3 shadow-sm d-flex align-items-center @(ShowSidebar ? "border-primary text-primary" : "")" @onclick="() => ShowSidebar = !ShowSidebar">
                                <i class="bi bi-funnel me-2"></i>Filter
                            </button>
                            
                            <div class="dropdown">
                                <button class="btn btn-white border fw-medium bg-white rounded-3 shadow-sm d-flex align-items-center" id="moreDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-three-dots"></i> More
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="moreDropdown">
                                    <li><button class="dropdown-item py-2" @onclick="ToggleReport"><i class="bi bi-file-earmark-text me-2 text-muted"></i>Generate Report</button></li>
                                    <li><button class="dropdown-item py-2" @onclick="ToggleSettings"><i class="bi bi-gear me-2 text-muted"></i>Table Settings</button></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><button class="dropdown-item py-2 text-danger" @onclick="ResetFilters"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset All Filters</button></li>
                                </ul>
                            </div>
                            <div class="btn-group shadow-sm rounded-3">
                                <button class="btn btn-white border bg-white @(ViewMode == "grid" ? "active text-primary" : "")" @onclick='() => ViewMode = "grid"'><i class="bi bi-grid"></i></button>
                                <button class="btn btn-white border bg-white @(ViewMode == "list" ? "active text-primary" : "")" @onclick='() => ViewMode = "list"'><i class="bi bi-list"></i></button>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-body p-0 flex-grow-1">
                        @if (IsLoading)
                        {
                            <div class="p-5 text-center text-muted">
                                <div class="spinner-border text-primary mb-3" role="status"></div>
                                <div>Loading students...</div>
                            </div>
                        }
                        else if (StudentsList == null || !StudentsList.Items.Any())
                        {
                            <div class="p-5 text-center text-muted">
                                <i class="bi bi-inbox fs-1"></i>
                                <p class="mt-2">No students matching your criteria were found.</p>
                            </div>
                        }
                        else if (ViewMode == "list")
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0 custom-datatable" id="studentsTable" style="width:100%">
                                    <thead style="background: #f8fafc;">
                                        <tr>
                                            <th class="ps-3" style="width: 40px; color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;"><input class="form-check-input" type="checkbox"></th>
                                            @foreach(var col in SelectedColumns)
                                            {
                                                if(col == "STUDENT_ID") continue;
                                                <th style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">@(col.Replace("_", " ")) &darr;</th>
                                            }
                                            <th class="text-end pe-3" style="color: #64748b; font-weight: 600; font-size: 0.75rem; text-transform: uppercase;">ACTIONS</th>
                                        </tr>
                                    </thead>
                                    <tbody class="border-top-0">
                                        @foreach (var student in StudentsList.Items)
                                        {
                                            <tr>
                                                <td class="ps-3"><input class="form-check-input" type="checkbox"></td>
                                                @foreach(var col in SelectedColumns)
                                                {
                                                    if(col == "STUDENT_ID") continue;

                                                    var val = GetColumnValue(student, col);
                                                    var displayVal = GetDisplayValue(student, col, val);

                                                    <td>
                                                        @if(col == "NAME")
                                                        {
                                                            <div class="d-flex align-items-center py-2">
                                                                <div class="me-3 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; border-radius: 8px; background: #eef2ff; color: #4f46e5; font-weight: 600; font-size: 0.9rem;">
                                                                    @(displayVal?.FirstOrDefault() ?? '?')
                                                                </div>
                                                                <div>
                                                                    <div class="fw-bold text-dark" style="font-size: 0.9rem;">@displayVal</div>
                                                                    <div class="text-muted" style="font-size: 0.8rem;">@(displayVal?.ToLower().Replace(" ", "."))@("@email.com")</div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else if(col == "MOBILE_NO")
                                                        {
                                                            <div class="d-flex align-items-center text-dark fw-medium" style="font-size: 0.9rem;">
                                                                <i class="bi bi-telephone text-muted me-2" style="font-size: 0.85rem;"></i>
                                                                @(string.IsNullOrEmpty(displayVal) || displayVal == "—" ? "N/A" : displayVal)
                                                            </div>
                                                        }
                                                        else if(col == "ADMISSION_NO")
                                                        {
                                                            <span class="text-primary fw-medium" style="font-size: 0.9rem;">@displayVal</span>
                                                        }
                                                        else if(col == "CLASS_ID")
                                                        {
                                                            <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #eef2ff; color: #4f46e5; font-size: 0.8rem;">@displayVal</span>
                                                        }
                                                        else if(col == "GENDER_ID")
                                                        {
                                                            <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #e0f2fe; color: #0284c7; font-size: 0.8rem;">@displayVal</span>
                                                        }
                                                        else if(col == "IS_ACTIVE" || col == "STATUS")
                                                        {
                                                            @if(val?.ToString() == "1" || displayVal == "Active") {
                                                                <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #dcfce7; color: #16a34a; font-size: 0.8rem;">Active</span>
                                                            } else {
                                                                <span class="badge rounded-pill px-3 py-2 fw-medium" style="background: #fef3c7; color: #d97706; font-size: 0.8rem;">Inactive</span>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <span class="text-dark fw-medium" style="font-size: 0.9rem;">@displayVal</span>
                                                        }
                                                    </td>
                                                }
                                                <td class="text-end pe-3">
                                                    <button class="btn btn-sm btn-white border rounded-2 me-1 shadow-sm" @onclick='() => EditStudent(GetStringValue(student, "STUDENT_ID"))'><i class="bi bi-pencil-square text-muted"></i></button>
                                                    <button class="btn btn-sm btn-white border rounded-2 shadow-sm text-danger" @onclick='() => DeleteStudent(GetStringValue(student, "STUDENT_ID"))'><i class="bi bi-trash"></i></button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <!-- Grid View -->
                            <div class="row g-3 p-3">
                                @foreach (var student in StudentsList.Items)
                                {
                                    <div class="col-md-6 col-lg-4">
                                        <div class="card border border-light shadow-sm rounded-4 h-100">
                                            <div class="card-body p-3">
                                                <div class="d-flex justify-content-between mb-3">
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; border-radius: 10px; background: #eef2ff; color: #4f46e5; font-weight: bold;">
                                                            @(GetStringValue(student, "NAME")?.FirstOrDefault() ?? '?')
                                                        </div>
                                                        <div>
                                                            <h6 class="mb-0 fw-bold text-dark">@GetStringValue(student, "NAME")</h6>
                                                            <small class="text-muted">@GetStringValue(student, "ADMISSION_NO")</small>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-between mb-2">
                                                    <span class="text-muted small">Class</span>
                                                    <span class="fw-medium small">@GetDisplayValue(student, "CLASS_ID", GetColumnValue(student, "CLASS_ID"))</span>
                                                </div>
                                                <div class="d-flex justify-content-between mb-3">
                                                    <span class="text-muted small">Mobile</span>
                                                    <span class="fw-medium small">@GetStringValue(student, "MOBILE_NO")</span>
                                                </div>
                                                <div class="d-flex justify-content-end border-top pt-3">
                                                    <button class="btn btn-sm btn-light me-2" @onclick='() => EditStudent(GetStringValue(student, "STUDENT_ID"))'>Edit</button>
                                                    <button class="btn btn-sm btn-light text-danger" @onclick='() => DeleteStudent(GetStringValue(student, "STUDENT_ID"))'>Delete</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    
                    <!-- Pagination (DataTables style custom) -->
                    @if (StudentsList != null && StudentsList.TotalPages > 0)
                    {
                        <div class="d-flex justify-content-between align-items-center p-3 px-4 mt-auto border-top">
                            <span class="text-muted fw-medium" style="font-size: 0.85rem;">Showing @(((PageNumber - 1) * PageSize) + 1) to @(Math.Min(PageNumber * PageSize, StudentsList.TotalCount)) of @StudentsList.TotalCount entries</span>
                            <div class="btn-group shadow-sm rounded-3">
                                <button class="btn btn-white border bg-white" disabled="@(!StudentsList.HasPreviousPage)" @onclick="() => LoadPage(PageNumber - 1)"><i class="bi bi-chevron-left text-muted"></i></button>
                                @for(int i = Math.Max(1, PageNumber - 2); i <= Math.Min(StudentsList.TotalPages, PageNumber + 2); i++)
                                {
                                    int p = i;
                                    <button class="btn btn-white border @(p == PageNumber ? "bg-primary bg-opacity-10 text-primary fw-bold" : "bg-white text-muted fw-medium")" style="min-width: 40px;" @onclick="() => LoadPage(p)">@p</button>
                                }
                                <button class="btn btn-white border bg-white" disabled="@(!StudentsList.HasNextPage)" @onclick="() => LoadPage(PageNumber + 1)"><i class="bi bi-chevron-right text-muted"></i></button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (ShowSidebar)
            {
                <!-- Right Sidebar Filters -->
                <div class="col-lg-3 animate-fade-in">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom py-2 px-3 d-flex justify-content-between align-items-center rounded-top-3">
                        <h5 class="mb-0 fw-bold d-flex align-items-center" style="font-size: 1.1rem;"><i class="bi bi-funnel text-muted me-2"></i>Filters</h5>
                        <button class="btn btn-link text-primary text-decoration-none fw-medium p-0" style="font-size: 0.85rem;" @onclick="ResetFilters">Clear All</button>
                    </div>
                    <div class="card-body p-3 d-flex flex-column">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Class</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium" value="@FilterClassId" @onchange="@(e => { FilterClassId = e.Value?.ToString(); })">
                                <option value="">All Classes</option>
                                @if (Classes != null)
                                {
                                    @foreach (var cls in Classes) { <option value="@cls.Value">@cls.Text</option> }
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Gender</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium" value="@FilterGenderId" @onchange="@(e => { FilterGenderId = e.Value?.ToString(); })">
                                <option value="">All Genders</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Status</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3 text-dark fw-medium">
                                <option>All Status</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark" style="font-size: 0.85rem;">Admission Date</label>
                            <div class="position-relative">
                                <input type="text" class="form-control bg-light border-0 py-2 pe-5 rounded-3 text-dark fw-medium" placeholder="01/01/2026 - 31/12/2026">
                                <i class="bi bi-calendar3 position-absolute top-50 end-0 translate-middle-y me-3 text-muted"></i>
                            </div>
                        </div>
                        
                        <div class="d-grid gap-3 mt-auto pt-4 border-top">
                            <button class="btn btn-primary py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;" @onclick="() => LoadPage(1)">Apply Filters</button>
                            <button class="btn btn-white border py-2 fw-medium rounded-3 d-flex align-items-center justify-content-center bg-white" @onclick="ResetFilters"><i class="bi bi-arrow-counterclockwise me-2"></i>Reset Filters</button>
                        </div>
                    </div>
                </div>
                </div>
            }
        </div>
    }
    else if (ShowForm)
    {
        <!-- Form View -->
        <div class="form-card animate-fade-in-up mt-3 p-3 card border-0 shadow-sm rounded-4">
            <h3 class="form-title fw-bold text-dark mb-3">@(IsEditMode ? "Edit Student Details" : "Register New Student")</h3>
            
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger d-flex align-items-center mb-3 rounded-3 border-0" style="background: rgba(239, 68, 68, 0.1); color: var(--danger-600);">
                    <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @ErrorMessage
                </div>
            }

            <EditForm Model="StudentForm" OnValidSubmit="SaveStudent">
                <DataAnnotationsValidator />
                
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Full Name</label>
                        <InputText @bind-Value="StudentForm.Name" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. John Doe" />
                        <ValidationMessage For="@(() => StudentForm.Name)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Admission No</label>
                        <InputText @bind-Value="StudentForm.AdmissionNo" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. ADM1001" />
                        <ValidationMessage For="@(() => StudentForm.AdmissionNo)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Email Address</label>
                        <InputText @bind-Value="StudentForm.EmailId" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. john@example.com" />
                        <ValidationMessage For="@(() => StudentForm.EmailId)" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mobile No</label>
                        <InputText @bind-Value="StudentForm.MobileNo" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. 9876543210" />
                        <ValidationMessage For="@(() => StudentForm.MobileNo)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Gender</label>
                        <InputSelect @bind-Value="StudentForm.GenderId" class="form-select bg-light border-0 py-2 rounded-3">
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => StudentForm.GenderId)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Date of Birth</label>
                        <InputDate @bind-Value="StudentForm.DateOfBirth" class="form-control bg-light border-0 py-2 rounded-3" />
                        <ValidationMessage For="@(() => StudentForm.DateOfBirth)" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Father's Name</label>
                        <InputText @bind-Value="StudentForm.FatherName" class="form-control bg-light border-0 py-2 rounded-3" placeholder="Father's full name" />
                        <ValidationMessage For="@(() => StudentForm.FatherName)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Mother's Name</label>
                        <InputText @bind-Value="StudentForm.MotherName" class="form-control bg-light border-0 py-2 rounded-3" placeholder="Mother's full name" />
                        <ValidationMessage For="@(() => StudentForm.MotherName)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Address</label>
                        <InputText @bind-Value="StudentForm.Address" class="form-control bg-light border-0 py-2 rounded-3" placeholder="Home address" />
                        <ValidationMessage For="@(() => StudentForm.Address)" class="text-danger small mt-1" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Class</label>
                        <InputSelect @bind-Value="StudentForm.ClassId" class="form-select bg-light border-0 py-2 rounded-3">
                            <option value="">Select Class</option>
                            @if (Classes != null)
                            {
                                @foreach (var c in Classes)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => StudentForm.ClassId)" class="text-danger small mt-1" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Register No</label>
                        <InputText @bind-Value="StudentForm.RegisterNo" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. REG1001" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Roll No</label>
                        <InputText @bind-Value="StudentForm.RollNo" class="form-control bg-light border-0 py-2 rounded-3" placeholder="e.g. 01" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">User ID (Optional)</label>
                        <InputText @bind-Value="StudentForm.UserId" class="form-control bg-light border-0 py-2 rounded-3" placeholder="Link to user account" />
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top">
                    <button type="button" class="btn btn-white border px-4 py-2 fw-medium rounded-3" @onclick="CancelForm">Discard</button>
                    <button type="submit" class="btn btn-primary px-4 py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;">@(IsEditMode ? "Update Student" : "Save Student")</button>
                </div>
            </EditForm>
        </div>
    }

    <!-- Modals (Settings & Report) -->
    @if (ShowSettingsModal)
    {
        <div class="settings-modal-overlay" @onclick="ToggleSettings">
            <div class="settings-modal animate-fade-in-up" @onclick:stopPropagation>
                <div class="settings-header">
                    <h4 class="modal-title-modern">@(IsAddingColumn ? "Add New Column" : "Dynamic Column Selection")</h4>
                    <button class="btn-close-square" @onclick="ToggleSettings">&times;</button>
                </div>
                
                @if (IsAddingColumn)
                {
                    <div class="settings-body">
                        <div class="form-group mb-3">
                            <label class="form-label">Column Name (e.g., COMMUNITY_ID)</label>
                            <input type="text" class="form-control bg-light border-0 py-2 rounded-3" @bind="NewColumnName" placeholder="Uppercase, no spaces" />
                        </div>
                        <div class="form-group mb-3">
                            <label class="form-label">Data Type</label>
                            <select class="form-select bg-light border-0 py-2 rounded-3" @bind="NewColumnDataType">
                                <option value="VARCHAR(255)">Text (VARCHAR)</option>
                                <option value="INT">Number (INT)</option>
                                <option value="DATE">Date (DATE)</option>
                            </select>
                        </div>
                        <div class="form-group mb-3">
                            <label class="d-flex align-items-center gap-2">
                                <input type="checkbox" class="form-check-input" @bind="IsNewColumnRef" />
                                <span>Is this an ID linking to a sub-table?</span>
                            </label>
                        </div>
                        @if(IsNewColumnRef)
                        {
                            <div class="form-group mb-3">
                                <label class="form-label">Reference Table Name (e.g. COMMUNITY)</label>
                                <input type="text" class="form-control bg-light border-0 py-2 rounded-3" @bind="RefTableName" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Reference Primary Key (e.g. COMMUNITY_ID)</label>
                                <input type="text" class="form-control bg-light border-0 py-2 rounded-3" @bind="RefPrimaryKey" />
                            </div>
                            <div class="form-group mb-3">
                                <label class="form-label">Reference Display Column (e.g. COMMUNITY_NAME)</label>
                                <input type="text" class="form-control bg-light border-0 py-2 rounded-3" @bind="RefDisplayColumn" />
                            </div>
                        }
                        
                        @if (!string.IsNullOrEmpty(ColumnAddError))
                        {
                            <div class="text-danger mt-2" style="font-size:0.85rem;">@ColumnAddError</div>
                        }
                    </div>
                    <div class="settings-footer" style="justify-content: space-between;">
                        <button class="btn btn-white border px-4 py-2 fw-medium rounded-3" @onclick="() => IsAddingColumn = false">Back</button>
                        <button class="btn btn-primary px-4 py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;" @onclick="AddNewColumn">Create Column</button>
                    </div>
                }
                else
                {
                    <div class="settings-body">
                        <p class="settings-desc-modern text-muted mb-3">Select the fields you want to fetch and display dynamically. Required fields cannot be deselected.</p>
                        <div class="column-selection-grid">
                            @foreach (var col in AvailableColumns)
                            {
                                bool isSelected = SelectedColumns.Contains(col.ColumnName);
                                bool isDisabled = col.ColumnName == "STUDENT_ID" || col.ColumnName == "NAME";
                                
                                <label class="column-pill @(isSelected ? "active" : "") @(isDisabled ? "disabled" : "")">
                                    <input type="checkbox" checked="@isSelected" 
                                           disabled="@isDisabled"
                                           @onchange="(e) => OnColumnSelectionChanged(col.ColumnName, e.Value)" />
                                    <div class="custom-checkbox">
                                        @if (isSelected)
                                        {
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"/></svg>
                                        }
                                    </div>
                                    <span class="column-name">@col.ColumnName</span>
                                </label>
                            }
                        </div>
                    </div>
                    <div class="settings-footer" style="justify-content: space-between;">
                        <button class="btn btn-white border px-4 py-2 fw-medium rounded-3 text-primary" style="border: 1px dashed var(--bs-primary) !important;" @onclick="() => IsAddingColumn = true">+ Add Field to DB</button>
                        <button class="btn btn-primary px-4 py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;" @onclick="ApplySettings">Apply & Fetch</button>
                    </div>
                }
            </div>
        </div>
    }

    @if (ShowReportModal)
    {
        <div class="settings-modal-overlay" @onclick="ToggleReport">
            <div class="settings-modal animate-fade-in-up" @onclick:stopPropagation>
                <div class="settings-header">
                    <h4 class="modal-title-modern">Generate Student Report</h4>
                    <button class="btn-close-square" @onclick="ToggleReport">&times;</button>
                </div>
                <div class="settings-body">
                    <div class="form-group mb-3">
                        <label class="form-label" style="font-weight: 600; color: #475569;">Report Type</label>
                        <select class="form-select bg-light border-0 py-2 rounded-3" @bind="ReportType">
                            <option value="General">General Student List</option>
                            <option value="Admission">Admission Register</option>
                            <option value="Contact">Contact Information</option>
                        </select>
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label" style="font-weight: 600; color: #475569;">Choose Columns to Include</label>
                        <div class="column-selection-grid">
                            @foreach (var col in AvailableColumns)
                            {
                                bool isSelected = SelectedReportColumns.Contains(col.ColumnName);
                                <label class="column-pill @(isSelected ? "active" : "")" style="padding: 0.5rem 0.75rem;">
                                    <input type="checkbox" checked="@isSelected" @onchange="(e) => OnReportColumnToggle(col.ColumnName, e.Value)" />
                                    <div class="custom-checkbox" style="width: 16px; height: 16px;">
                                        @if (isSelected)
                                        {
                                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><polyline points="20 6 9 17 4 12"/></svg>
                                        }
                                    </div>
                                    <span class="column-name" style="font-size: 0.8rem;">@col.ColumnName</span>
                                </label>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label" style="font-weight: 600; color: #475569;">Export Format</label>
                        <div style="display: flex; gap: 1rem;">
                            <label class="column-pill @(ReportExportType == "Excel" ? "active" : "")" style="flex: 1; justify-content: center; cursor: pointer;" @onclick='() => ReportExportType = "Excel"'>
                                <input type="radio" name="exportType" checked='@(ReportExportType == "Excel")' style="display: none;" />
                                <span class="column-name">Excel (.xlsx)</span>
                            </label>
                            <label class="column-pill @(ReportExportType == "PDF" ? "active" : "")" style="flex: 1; justify-content: center; cursor: pointer;" @onclick='() => ReportExportType = "PDF"'>
                                <input type="radio" name="exportType" checked='@(ReportExportType == "PDF")' style="display: none;" />
                                <span class="column-name">PDF (.pdf)</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="settings-footer">
                    @if (IsGeneratingReport)
                    {
                        <button class="btn btn-primary px-4 py-2 fw-medium rounded-3" disabled style="background: #4f46e5; border-color: #4f46e5; opacity: 0.8; cursor: wait;">
                             Generating...
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-primary px-4 py-2 fw-medium rounded-3" style="background: #4f46e5; border-color: #4f46e5;" @onclick="GenerateReport">Generate & Download</button>
                    }
                </div>
            </div>
        </div>
    }
</div>

