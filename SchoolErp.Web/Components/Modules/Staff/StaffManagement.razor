@page "/staff-management"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using SchoolErp.Application.Common.Interfaces
@using SchoolErp.Application.Common.Models
@using SchoolErp.Web.Components.Shared
@inject ICommonDataService CommonData
@inject IAcademicService AcademicService

<div class="management-container animate-fade-in-up">
    <header class="page-header">
        <div class="header-main">
            <h1>Staff Management</h1>
            <p>Manage faculty, administrative, and support staff records</p>
        </div>
        @if (!ShowForm)
        {
            <button class="btn-primary-modern" @onclick="OpenAddForm">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                Add New Staff
            </button>
        }
    </header>

    @if (!ShowForm)
    {
        <!-- Unified Toolbar: Search + Filter + View Toggle -->
        <div class="list-toolbar animate-fade-in">
            <div class="list-toolbar-left">
                <div class="toolbar-search">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                    <input type="text" placeholder="Search by name, department, or ID..." @bind="SearchTerm" @bind:event="oninput" />
                </div>
                <select @bind="SelectedDepartment" class="form-select-modern" style="width: 200px; height: 38px; padding: 0.4rem 2.5rem 0.4rem 0.75rem; font-size: 0.85rem;">
                    <option value="">All Departments</option>
                    @foreach (var dept in Departments)
                    {
                        <option value="@dept.Value">@dept.Text</option>
                    }
                </select>
                <span class="result-count">@FilteredStaff.Count() result(s)</span>
            </div>
            <div class="list-toolbar-right">
                <div class="view-toggle">
                    <button class="view-btn @(ViewMode == "grid" ? "active" : "")" title="Grid View" @onclick='() => ViewMode = "grid"'>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                    </button>
                    <button class="view-btn @(ViewMode == "list" ? "active" : "")" title="List View" @onclick='() => ViewMode = "list"'>
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                    </button>
                </div>
            </div>
        </div>

        @if (!FilteredStaff.Any())
        {
            <div class="empty-state">
                <svg width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <p>No staff records found matching your criteria.</p>
            </div>
        }
        else if (ViewMode == "list")
        {
            <!-- LIST VIEW: Table -->
            <div class="table-card animate-fade-in">
                <div class="table-responsive">
                    <table class="modern-table">
                        <thead>
                            <tr>
                                <th>Staff Member</th>
                                <th>Department</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var staff in FilteredStaff)
                            {
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 1rem;">
                                            <div class="avatar-modern">@staff.NAME[0]</div>
                                            <div>
                                                <div style="font-weight: 700;">@staff.NAME</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">@staff.STAFF_CODE</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="badge-modern badge-info">@staff.DEPARTMENT</span></td>
                                    <td>@staff.CATEGORY_NAME</td>
                                    <td>
                                        <span class="badge-modern @(staff.IS_ACTIVE == "1" ? "badge-success" : "badge-danger")">
                                            <span class="status-dot @(staff.IS_ACTIVE == "1" ? "bg-success" : "bg-danger")"></span>
                                            @(staff.IS_ACTIVE == "1" ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="action-buttons" style="justify-content: flex-end;">
                                            <button class="btn-icon-modern" title="Edit" @onclick="() => EditStaff(staff)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                                            <button class="btn-icon-modern danger" title="Delete" @onclick="() => DeleteStaff(staff.STAFF_ID)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else
        {
            <!-- GRID VIEW: Cards -->
            <div class="data-grid animate-fade-in">
                @foreach (var staff in FilteredStaff)
                {
                    <div class="data-card">
                        <div class="data-card-header">
                            <div class="data-card-avatar">@staff.NAME[0]</div>
                            <div>
                                <div class="data-card-title">@staff.NAME</div>
                                <div class="data-card-subtitle">@staff.STAFF_CODE</div>
                            </div>
                        </div>
                        <div class="data-card-body">
                            <div class="data-card-row">
                                <span class="data-card-label">Department</span>
                                <span class="badge-modern badge-info" style="font-size: 0.72rem; padding: 0.2rem 0.6rem;">@(string.IsNullOrEmpty(staff.DEPARTMENT) ? "—" : staff.DEPARTMENT)</span>
                            </div>
                            <div class="data-card-row">
                                <span class="data-card-label">Category</span>
                                <span class="data-card-value">@(string.IsNullOrEmpty(staff.CATEGORY_NAME) ? "—" : staff.CATEGORY_NAME)</span>
                            </div>
                            <div class="data-card-row">
                                <span class="data-card-label">Status</span>
                                <span class="badge-modern @(staff.IS_ACTIVE == "1" ? "badge-success" : "badge-danger")" style="font-size: 0.72rem; padding: 0.2rem 0.6rem;">
                                    <span class="status-dot @(staff.IS_ACTIVE == "1" ? "bg-success" : "bg-danger")"></span>
                                    @(staff.IS_ACTIVE == "1" ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                        <div class="data-card-actions">
                            <button class="btn-icon-modern" title="Edit" @onclick="() => EditStaff(staff)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                            <button class="btn-icon-modern danger" title="Delete" @onclick="() => DeleteStaff(staff.STAFF_ID)"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <!-- Add/Edit Staff Form -->
        <div class="form-card animate-fade-in-up" style="max-width: 900px; margin: 0 auto;">
            <div class="form-title">
                <div style="display: flex; align-items: center; gap: 0.75rem;">
                    <div class="avatar-modern" style="background: var(--primary-100); color: var(--primary-700);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
                    </div>
                    <span>@(string.IsNullOrEmpty(NewStaff.STAFF_ID) ? "Add New Staff Profile" : "Edit Staff Profile")</span>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-12"><h4 class="section-subtitle">Personal Details</h4></div>
                
                <div class="col-md-6">
                    <label class="form-label">Full Name</label>
                    <input type="text" class="form-control-modern" @bind="NewStaff.NAME" placeholder="Enter full name" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Staff Code</label>
                    <input type="text" class="form-control-modern" @bind="NewStaff.STAFF_CODE" placeholder="EMP-001" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date of Birth</label>
                    <DatePicker @bind-Value="NewStaff.DATE_OF_BIRTH" />
                </div>
                
                <div class="col-md-4">
                    <label class="form-label">Department</label>
                    <select class="form-select-modern" @bind="NewStaff.DEPARTMEMT_ID">
                        <option value="">Select Department</option>
                        @foreach (var dept in Departments)
                        {
                            <option value="@dept.Value">@dept.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Staff Category</label>
                    <select class="form-select-modern" @bind="NewStaff.CATEGORY_ID">
                        <option value="">Select Category</option>
                        @foreach (var cat in Categories)
                        {
                            <option value="@cat.Value">@cat.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Designation</label>
                    <select class="form-select-modern" @bind="NewStaff.DESIGNATION_ID">
                        <option value="">Select Designation</option>
                        @foreach (var desig in Designations)
                        {
                            <option value="@desig.Value">@desig.Text</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Qualification</label>
                    <select class="form-select-modern" @bind="NewStaff.QUALIFICATION_ID">
                        <option value="">Select Qualification</option>
                        @foreach (var qual in Qualifications)
                        {
                            <option value="@qual.Value">@qual.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Blood Group</label>
                    <select class="form-select-modern" @bind="NewStaff.BLOOD_ID">
                        <option value="">Select Blood Group</option>
                        @foreach (var blood in BloodGroups)
                        {
                            <option value="@blood.Value">@blood.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Status</label>
                    <select class="form-select-modern" @bind="NewStaff.IS_ACTIVE">
                        <option value="1">Active</option>
                        <option value="0">Inactive</option>
                    </select>
                </div>

                <div class="col-12 mt-4"><h4 class="section-subtitle">Contact & Address</h4></div>
                <div class="col-md-6">
                    <label class="form-label">Mobile Number</label>
                    <input type="text" class="form-control-modern" @bind="NewStaff.MOBILE" placeholder="+91 00000 00000" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Alternative Phone</label>
                    <input type="text" class="form-control-modern" @bind="NewStaff.PHONE" />
                </div>
                <div class="col-12">
                    <label class="form-label">Residential Address</label>
                    <textarea class="form-control-modern" rows="2" @bind="NewStaff.ADDRESS" placeholder="Full residential address"></textarea>
                </div>
            </div>

            <div class="form-actions" style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                <button type="button" class="btn-secondary-modern" @onclick="CloseForm">Discard & Return</button>
                <button type="button" class="btn-primary-modern" @onclick="SaveStaff">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
                    @(string.IsNullOrEmpty(NewStaff.STAFF_ID) ? "Confirm & Save Profile" : "Update Profile")
                </button>
            </div>
        </div>
    }
</div>

<style>
    .section-subtitle {
        font-size: 0.85rem;
        color: var(--primary-500);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 700;
        margin: 0;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--primary-50);
    }
</style>

@code {
    private string SearchTerm = "";
    private string SelectedDepartment = "";
    private string ViewMode = "list";
    private List<DropdownItem> Departments = new();
    private List<DropdownItem> Categories = new();
    private List<DropdownItem> Designations = new();
    private List<DropdownItem> BloodGroups = new();
    private List<DropdownItem> Qualifications = new();
    private List<StaffDirectoryModel> StaffMembers = new();
    private bool ShowForm = false;
    private StaffDirectoryModel NewStaff = new();

    protected override async Task OnInitializedAsync()
    {
        Departments = await AcademicService.GetDynamicListAsync("DEPARTMENTS", "DEPT_ID", "DEPT_NAME");
        Categories = await CommonData.GetStaffCategoryListAsync();
        Designations = await AcademicService.GetDynamicListAsync("sup_designation", "DESIGANTION_ID", "DESIGANTION_NAME");
        BloodGroups = await AcademicService.GetDynamicListAsync("SUP_BLOOD_GROUP", "BLOOD_ID", "BLOOD_NAME");
        Qualifications = await AcademicService.GetDynamicListAsync("SUP_QUALIFICATION", "QUALIFICATION_ID", "QUALIFICATION_NAME");
        await LoadStaff();
    }

    private async Task LoadStaff()
    {
        StaffMembers = await AcademicService.GetStaffDirectoryAsync();
    }

    private IEnumerable<StaffDirectoryModel> FilteredStaff => StaffMembers
        .Where(s => (string.IsNullOrEmpty(SearchTerm) || s.NAME.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase) || s.STAFF_CODE.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)));

    private void OpenAddForm() 
    {
        NewStaff = new StaffDirectoryModel { IS_ACTIVE = "1" };
        ShowForm = true;
    }

    private void EditStaff(StaffDirectoryModel staff)
    {
        NewStaff = new StaffDirectoryModel
        {
            STAFF_ID = staff.STAFF_ID,
            NAME = staff.NAME,
            STAFF_CODE = staff.STAFF_CODE,
            DATE_OF_BIRTH = staff.DATE_OF_BIRTH,
            DEPARTMENT = staff.DEPARTMENT,
            DEPARTMEMT_ID = staff.DEPARTMEMT_ID,
            BLOOD_ID = staff.BLOOD_ID,
            MOBILE = staff.MOBILE,
            PHONE = staff.PHONE,
            ADDRESS = staff.ADDRESS,
            CATEGORY_ID = staff.CATEGORY_ID,
            QUALIFICATION_ID = staff.QUALIFICATION_ID,
            DESIGNATION_ID = staff.DESIGNATION_ID,
            IS_ACTIVE = staff.IS_ACTIVE
        };
        ShowForm = true;
    }

    private void CloseForm() => ShowForm = false;

    private async Task SaveStaff()
    {
        if (string.IsNullOrWhiteSpace(NewStaff.NAME)) return;

        if (await AcademicService.SaveStaffAsync(NewStaff))
        {
            await LoadStaff();
            CloseForm();
            NewStaff = new();
        }
    }

    private async Task DeleteStaff(string id)
    {
        if (await AcademicService.DeleteStaffAsync(id))
        {
            await LoadStaff();
        }
    }
}
