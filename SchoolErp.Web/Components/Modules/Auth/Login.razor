@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using SchoolErp.Application.Features.Auth.Login
@using SchoolErp.Application.Common.Mediator
@layout SchoolErp.Web.Components.Layout.LoginLayout
@inject IMediator Mediator
@inject NavigationManager NavigationManager
@inject SchoolErp.Application.Common.Interfaces.IErrorLogger ErrorLogger

<PageTitle>Login - School ERP</PageTitle>

<div class="login-page">
    <div class="login-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
    </div>

    <div class="login-card">
        <div class="login-brand">
            <div class="login-logo">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <rect width="40" height="40" rx="12" fill="url(#logoGrad)" />
                    <path d="M12 28V16L20 11L28 16V28" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M17 28V22H23V28" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="20" cy="17" r="2" fill="white"/>
                    <defs>
                        <linearGradient id="logoGrad" x1="0" y1="0" x2="40" y2="40">
                            <stop stop-color="#3b82f6"/>
                            <stop offset="1" stop-color="#8b5cf6"/>
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <h1 class="login-title">SchoolERP</h1>
            <p class="login-subtitle">Welcome back! Sign in to your account</p>
        </div>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-error">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 1a7 7 0 100 14A7 7 0 008 1zm-.75 4.25a.75.75 0 011.5 0v3.5a.75.75 0 01-1.5 0v-3.5zM8 11a1 1 0 110 2 1 1 0 010-2z"/>
                </svg>
                <span>@ErrorMessage</span>
            </div>
        }

        <EditForm Model="Model" method="post" OnValidSubmit="LoginAsync" FormName="loginForm">
            <DataAnnotationsValidator />

            <div class="form-field">
                <label for="login-email">Email Address</label>
                <div class="input-wrapper">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="4" width="20" height="16" rx="3"/>
                        <path d="M2 7l10 7 10-7"/>
                    </svg>
                    <InputText id="login-email" @bind-Value="Model.Email" class="input-modern" placeholder="you@school.edu" required />
                </div>
            </div>

            <div class="form-field">
                <div class="label-row">
                    <label for="login-password">Password</label>
                    <a href="#" class="forgot-link">Forgot password?</a>
                </div>
                <div class="input-wrapper">
                    <svg class="input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="5" y="11" width="14" height="10" rx="2"/>
                        <path d="M8 11V7a4 4 0 018 0v4"/>
                    </svg>
                    <InputText id="login-password" type="password" @bind-Value="Model.Password" class="input-modern" placeholder="Enter your password" required />
                </div>
            </div>

            <button type="submit" class="btn-login" id="login-submit-btn">
                <span>Sign In</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
            </button>
        </EditForm>

        <div class="login-footer">
            <p>Secured with <span class="footer-highlight">256-bit encryption</span></p>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    public LoginCommand Model { get; set; } = default!;

    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    public string? ErrorMessage { get; set; }

    protected override void OnInitialized()
    {
        Model ??= new();
    }

    private async Task LoginAsync()
    {
        try
        {
            if (HttpContext == null)
            {
                ErrorMessage = "System Error: HttpContext is null. Please check render mode settings.";
                return;
            }

            var result = await Mediator.Send(Model);

            if (!result.Success)
            {
                ErrorMessage = result.ErrorMessage;
                return;
            }

            // Generate Claims for Cookie
            var handler = new System.IdentityModel.Tokens.Jwt.JwtSecurityTokenHandler();
            var jwtToken = handler.ReadJwtToken(result.Token);

            var identity = new ClaimsIdentity(jwtToken.Claims, CookieAuthenticationDefaults.AuthenticationScheme);
            var principal = new ClaimsPrincipal(identity);

            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal, new AuthenticationProperties
            {
                IsPersistent = true,
                ExpiresUtc = jwtToken.ValidTo
            });

            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Login process error: {ex.Message}";
            await ErrorLogger.LogErrorAsync(ex, source: "Login.razor");
        }
    }
}
