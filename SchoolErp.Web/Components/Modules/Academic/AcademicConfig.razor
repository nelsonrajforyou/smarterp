@page "/academic-config"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using SchoolErp.Application.Common.Interfaces
@using SchoolErp.Web.Components.Modules.Academic.Tabs
@inject ICommonDataService CommonData
@inject NavigationManager Nav

<div class="academic-config-container">
    <!-- Header Section -->
    <header class="config-header">
        <div class="header-content">
            <div class="title-area">
                <div class="icon-box">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                </div>
                <div>
                    <h1>Academic Configuration</h1>
                    <p class="subtitle">Manage classes, years, and system support tables</p>
                </div>
            </div>
            <div class="quick-actions">
                <button class="btn-quick action-add" @onclick="() => SetTab(1)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    New Class
                </button>
                <button class="btn-quick action-sync" @onclick="RefreshData">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>
                    Refresh
                </button>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-nav">
            <button class="tab-item @(ActiveTab == 1 ? "active" : "")" @onclick="() => SetTab(1)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Classes
            </button>
            <button class="tab-item @(ActiveTab == 2 ? "active" : "")" @onclick="() => SetTab(2)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                Academic Year
            </button>
            <button class="tab-item @(ActiveTab == 3 ? "active" : "")" @onclick="() => SetTab(3)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Support Tables
            </button>
            <button class="tab-item @(ActiveTab == 4 ? "active" : "")" @onclick="() => SetTab(4)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                Subjects
            </button>
            <button class="tab-item @(ActiveTab == 5 ? "active" : "")" @onclick="() => SetTab(5)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><polyline points="17 11 19 13 23 9"/></svg>
                Student Mapping
            </button>
            <button class="tab-item @(ActiveTab == 6 ? "active" : "")" @onclick="() => SetTab(6)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                Staff Mapping
            </button>
            <button class="tab-item @(ActiveTab == 7 ? "active" : "")" @onclick="() => SetTab(7)">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                Bulk Edit
            </button>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="config-content">
        <div class="content-wrapper">
            @if (ActiveTab == 1)
            {
                <ClassList />
            }
            else if (ActiveTab == 2)
            {
                <AcademicYearList />
            }
            else if (ActiveTab == 3)
            {
                <SupportTables />
            }
            else if (ActiveTab == 4)
            {
                <SubjectList />
            }
            else if (ActiveTab == 5)
            {
                <StudentMapping />
            }
            else if (ActiveTab == 6)
            {
                <SubjectStaffMapping />
            }
            else if (ActiveTab == 7)
            {
                <BulkEdit />
            }
        </div>

        <!-- Sidebar Actions -->
        <aside class="config-sidebar">
            <div class="sidebar-card">
                <h3>Quick Insights</h3>
                <div class="insight-item">
                    <span class="label">Total Classes</span>
                    <span class="value">@TotalClasses</span>
                </div>
                <div class="insight-item">
                    <span class="label">Active Year</span>
                    <span class="value highlight">@ActiveYearName</span>
                </div>
            </div>

            <div class="sidebar-card">
                <h3>Global Actions</h3>
                <button class="btn-side"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Export Config</button>
                <button class="btn-side danger"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg> Purge Drafts</button>
            </div>
        </aside>
    </main>
</div>

@code {
    private int ActiveTab { get; set; } = 1;
    private int TotalClasses { get; set; } = 0;
    private string ActiveYearName { get; set; } = "2024-25";

    protected override async Task OnInitializedAsync()
    {
        await RefreshData();
    }

    private void SetTab(int tabIndex)
    {
        ActiveTab = tabIndex;
    }

    private async Task RefreshData()
    {
        var years = await CommonData.GetAcademicYearListAsync();
        ActiveYearName = years.FirstOrDefault()?.Text ?? "N/A";
        
        var classes = await CommonData.GetClassListAsync();
        TotalClasses = classes.Count;
        
        StateHasChanged();
    }
}
