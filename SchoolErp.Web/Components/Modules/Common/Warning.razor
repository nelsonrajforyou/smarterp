@page "/warning"
@layout SchoolErp.Web.Components.Layout.LoginLayout
@inject NavigationManager NavigationManager

<PageTitle>System Warning - SchoolERP</PageTitle>

<div class="status-page warning-theme">
    <div class="status-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
    </div>

    <div class="status-card animate-fade-in-up">
        <div class="status-icon-wrapper">
            <div class="status-icon">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
        </div>

        <h1 class="status-title">Warning</h1>
        <p class="status-message">
            @(Message ?? "A system warning has occurred. Please verify your last action or contact support if the issue persists.")
        </p>

        <div class="status-actions">
            <button class="btn-status-primary" @onclick='() => NavigationManager.NavigateTo("/")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Return to Safety
            </button>
        </div>

        <div class="status-footer">
            <p>Need clarification? <a href="mailto:support@schoolerp.edu">Ask an expert</a></p>
        </div>
    </div>
</div>

<style>
    .status-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #f8fafc;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .status-bg-shapes .shape {
        position: absolute;
        filter: blur(80px);
        opacity: 0.4;
        z-index: 0;
    }

    .shape-1 {
        width: 400px;
        height: 400px;
        background: #f59e0b;
        top: -100px;
        left: -100px;
    }

    .shape-2 {
        width: 300px;
        height: 300px;
        background: #fbbf24;
        bottom: -50px;
        right: -50px;
    }

    .status-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 3rem;
        width: 100%;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 1;
    }

    .status-icon-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .status-icon {
        width: 100px;
        height: 100px;
        background: #fef3c7;
        color: #d97706;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: shake 0.5s ease-in-out infinite alternate;
    }

    @@keyframes shake {
        from { transform: rotate(-5deg); }
        to { transform: rotate(5deg); }
    }

    .status-title {
        font-size: 2.5rem;
        font-weight: 900;
        color: #1e293b;
        margin-bottom: 1rem;
        letter-spacing: -0.04em;
    }

    .status-message {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .status-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .btn-status-primary {
        background: #d97706;
        color: white;
        border: none;
        padding: 0.875rem;
        border-radius: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-status-primary:hover {
        background: #b45309;
        transform: translateY(-2px);
    }

    .status-footer {
        font-size: 0.875rem;
        color: #94a3b8;
    }

    .status-footer a {
        color: #d97706;
        text-decoration: none;
        font-weight: 600;
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

@code {
    [SupplyParameterFromQuery]
    public string? Message { get; set; }
}
