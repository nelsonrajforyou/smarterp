@page "/not-found"
@layout SchoolErp.Web.Components.Layout.LoginLayout
@inject NavigationManager NavigationManager

<PageTitle>Page Not Found - SchoolERP</PageTitle>

<div class="status-page notfound-theme">
    <div class="status-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
    </div>

    <div class="status-card animate-fade-in-up">
        <div class="status-icon-wrapper">
            <div class="status-icon">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
            </div>
        </div>

        <h1 class="status-title">404</h1>
        <h2 style="font-size: 1.25rem; font-weight: 600; color: #475569; margin-bottom: 1rem;">Page Not Found</h2>
        <p class="status-message">
            The page you're looking for doesn't exist or has been moved to a new location.
        </p>

        <div class="status-actions">
            <button class="btn-status-primary" @onclick='() => NavigationManager.NavigateTo("/")'>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                Back to Safety
            </button>
        </div>

        <div class="status-footer">
            <p>Lost? Try searching our <a href="/">Dashboard</a></p>
        </div>
    </div>
</div>

<style>
    .status-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        background: #f8fafc;
        position: relative;
        overflow: hidden;
        font-family: 'Inter', sans-serif;
    }

    .status-bg-shapes .shape {
        position: absolute;
        filter: blur(80px);
        opacity: 0.4;
        z-index: 0;
    }

    .shape-1 {
        width: 400px;
        height: 400px;
        background: #3b82f6;
        top: -100px;
        left: -100px;
    }

    .shape-2 {
        width: 300px;
        height: 300px;
        background: #8b5cf6;
        bottom: -50px;
        right: -50px;
    }

    .status-card {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 24px;
        padding: 3rem;
        width: 100%;
        max-width: 500px;
        text-align: center;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.1);
        position: relative;
        z-index: 1;
    }

    .status-icon-wrapper {
        display: flex;
        justify-content: center;
        margin-bottom: 2rem;
    }

    .status-icon {
        width: 100px;
        height: 100px;
        background: #dbeafe;
        color: #3b82f6;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .status-title {
        font-size: 4rem;
        font-weight: 900;
        color: #1e293b;
        margin-bottom: 0.5rem;
        letter-spacing: -0.05em;
        line-height: 1;
    }

    .status-message {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .status-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
    }

    .btn-status-primary {
        background: #1e293b;
        color: white;
        border: none;
        padding: 0.875rem;
        border-radius: 12px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-status-primary:hover {
        background: #0f172a;
        transform: translateY(-2px);
    }

    .status-footer {
        font-size: 0.875rem;
        color: #94a3b8;
    }

    .status-footer a {
        color: #3b82f6;
        text-decoration: none;
        font-weight: 600;
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.6s ease-out;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>
