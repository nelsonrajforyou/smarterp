@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="datepicker-wrapper">
    <div class="input-group-modern">
        <input @ref="dateInput" 
               type="text" 
               class="form-control-modern @(Disabled ? "disabled" : "")" 
               placeholder="@Placeholder" 
               disabled="@Disabled" />
        <span class="input-group-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
        </span>
    </div>
</div>

@code {
    [Parameter] public DateTime? Value { get; set; }
    [Parameter] public EventCallback<DateTime?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Select date...";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string DateFormat { get; set; } = "d-m-Y";

    private ElementReference dateInput;
    private DotNetObjectReference<DatePicker>? objRef;
    private bool isInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                objRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("datepicker.init", dateInput, new { 
                    dateFormat = DateFormat,
                    defaultDate = Value?.ToString("yyyy-MM-dd")
                }, objRef);
                isInitialized = true;
            }
            catch (JSDisconnectedException) { /* Circuit disconnected during initialization */ }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (isInitialized)
            {
                await JS.InvokeVoidAsync("datepicker.setValue", dateInput, Value?.ToString("yyyy-MM-dd"));
            }
        }
        catch (JSDisconnectedException) { /* Circuit disconnected */ }
    }

    [JSInvokable]
    public async Task OnDateChanged(string dateStr)
    {
        // Try parsing with the display format or ISO format
        string dotnetFormat = DateFormat.Replace("d", "dd").Replace("m", "MM").Replace("Y", "yyyy");
        
        if (DateTime.TryParseExact(dateStr, dotnetFormat, null, System.Globalization.DateTimeStyles.None, out var date) ||
            DateTime.TryParse(dateStr, out date))
        {
            Value = date;
        }
        else
        {
            Value = null;
        }
        await ValueChanged.InvokeAsync(Value);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (isInitialized)
            {
                await JS.InvokeVoidAsync("datepicker.destroy", dateInput);
            }
        }
        catch (JSDisconnectedException)
        {
            // Ignore: circuit is already disconnected
        }
        catch (Exception)
        {
            // Best effort disposal
        }
        finally
        {
            objRef?.Dispose();
        }
    }
}


